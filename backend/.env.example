NODE_ENV=development

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling            # polling (local) | webhook (producción, lo agrega DK-102)
WEBHOOK_DOMAIN=                  # https://tu-app.up.railway.app (solo webhook)
WEBHOOK_SECRET=                  # cadena aleatoria para validar el webhook
PORT=3000

# Base de datos (aún no usada: mientras esté vacía, los repositorios mock se activan solos)
DATABASE_URL=
DATABASE_SSL=false

# Forzar repositorios en memoria aunque exista DATABASE_URL
USE_MOCK_REPOS=true

# IA (Sprint 2)
# Mientras ANTHROPIC_API_KEY esté vacía se usa el extractor por regex (gratis, sin red).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Forzar el extractor simulado aunque exista ANTHROPIC_API_KEY
USE_MOCK_AI=true

# Passphrase para pgp_sym_encrypt / pgp_sym_decrypt. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Administradores (Telegram IDs separados por coma)
ADMIN_TELEGRAM_IDS=

# Zona horaria para cron y recordatorios
TZ=America/Mexico_City
