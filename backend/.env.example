NODE_ENV=development

# --- Telegram ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# polling (local) | webhook (producción)
TELEGRAM_MODE=polling
# Solo webhook: https://tu-app.up.railway.app (sin ruta; el bot usa /telegram/webhook)
WEBHOOK_DOMAIN=
# Solo webhook: 32-256 caracteres [A-Za-z0-9_-]. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=
# Puerto de Express (GET /health y webhook)
PORT=3000

# --- Base de datos ----------------------------------------------------
# Local con docker compose: postgres://diag:diag@localhost:5433/asistente_cronicas
# En producción, conectarse con el rol de mínimo privilegio (src/db/roles.sql).
DATABASE_URL=
DATABASE_SSL=false

# --- Datos de prueba (solo `npm run db:seed`) -------------------------
# Datos ficticios. Debe ser "true" además de NODE_ENV != production.
ALLOW_SEED=false

# true = repositorios en memoria (no se guarda nada al reiniciar).
# false = PostgreSQL (requiere DATABASE_URL, ENCRYPTION_KEY y `npm run db:migrate`).
# Si se deja vacío, se usa mock cuando DATABASE_URL está vacía.
USE_MOCK_REPOS=true

# Solo pruebas de integración (`npm test`). El nombre de la BD debe contener "test":
# cada prueba la vacía con TRUNCATE. Con docker compose:
# postgres://diag:diag@localhost:5433/asistente_cronicas_test
TEST_DATABASE_URL=

# --- IA (Groq) --------------------------------------------------------
# Llave de https://console.groq.com/keys. Mientras esté vacía se usa el
# extractor por regex (gratis, sin red).
GROQ_API_KEY=
# Debe ser un modelo con Structured Outputs en modo estricto
# (openai/gpt-oss-20b u openai/gpt-oss-120b).
GROQ_MODEL=openai/gpt-oss-20b
# Forzar el extractor simulado aunque exista GROQ_API_KEY
USE_MOCK_AI=true

# --- Cifrado ----------------------------------------------------------
# Passphrase para pgp_sym_encrypt / pgp_sym_decrypt (mínimo 32 caracteres). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se pierde, los datos cifrados ya no se pueden leer.
ENCRYPTION_KEY=

# --- Trazabilidad -----------------------------------------------------
# Días que se conserva (cifrado y anonimizado) el mensaje que originó cada reporte.
# Al vencer se borra solo; los registros clínicos se conservan. Vacío = 90.
MENSAJES_RETENCION_DIAS=90

# --- Administración ---------------------------------------------------
# Telegram IDs separados por coma
ADMIN_TELEGRAM_IDS=

# Zona horaria para cron y recordatorios
TZ=America/Mexico_City
